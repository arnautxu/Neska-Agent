# /etc/neska/<client>/code.env  (chmod 600, root only). Never commit real values.
# Secrets for the Neska code sandbox (librechat/neska/code/docker-compose.yml).
NESKA_CLIENT=prova
CODEAPI_REGISTRY=ghcr.io/arnautxu
# Our arm64 builds are named neska-codeapi-<service>; upstream's are code-interpreter-<service>.
CODEAPI_IMAGE_PREFIX=neska-codeapi
# sha-<full upstream commit>-<neska_patch> from the Build Neska code sandbox workflow.
CODEAPI_IMAGE_TAG=sha-<upstream commit>-neska2
CODEAPI_DATA=/srv/neska/prova/code
CODEAPI_PKGS=/srv/neska/prova/code/pkgs

# openssl rand -hex 32 (redis/minio: -hex 16)
CODEAPI_REDIS_PASSWORD=
CODEAPI_INTERNAL_SERVICE_TOKEN=
CODEAPI_EGRESS_GRANT_SECRET=
CODEAPI_MINIO_USER=neska
CODEAPI_MINIO_PASSWORD=

# Execution manifest keypair (Ed25519, base64 DER):
#   openssl genpkey -algorithm ed25519 -out manifest.pem
#   CODEAPI_EXECUTION_MANIFEST_PRIVATE_KEY = openssl pkey -in manifest.pem -outform DER | base64 -w0
#   SANDBOX_EXECUTION_MANIFEST_PUBLIC_KEY  = openssl pkey -in manifest.pem -pubout -outform DER | base64 -w0
CODEAPI_EXECUTION_MANIFEST_PRIVATE_KEY=
SANDBOX_EXECUTION_MANIFEST_PUBLIC_KEY=

# Public half of the LibreChat signing key (PEM on one line with \n). The private half
# goes in neska.env as CODEAPI_JWT_PRIVATE_KEY_BASE64.
#   openssl genpkey -algorithm ed25519 -out codeapi-jwt.pem
#   openssl pkey -in codeapi-jwt.pem -pubout
CODEAPI_JWT_PUBLIC_KEY=
