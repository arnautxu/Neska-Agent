# /etc/neska/<client>/neska.env  (chmod 600, root only). Never commit real values.
NESKA_CLIENT=prova
NESKA_DOMAIN=prova.neska.cat
NESKA_DATA=/srv/neska/prova
NESKA_CONFIG=/etc/neska/prova/librechat.yaml
NESKA_ENV_FILE=/etc/neska/prova/neska.env

DOMAIN_CLIENT=https://prova.neska.cat
DOMAIN_SERVER=https://prova.neska.cat
APP_TITLE=Neska

# Generate each with: openssl rand -hex 32 (CREDS_IV: openssl rand -hex 16)
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=
MEILI_MASTER_KEY=
SEARCH=true

# Accounts: the operator creates users; nobody can sign up on their own.
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=false
ALLOW_SOCIAL_LOGIN=false

# Models: Claude only, one company key for everyone (users pick Ràpid / Intel·ligent,
# never a key or a raw model). Put the real key here; never commit it.
ENDPOINTS=anthropic
ANTHROPIC_API_KEY=replace-with-company-anthropic-key
ANTHROPIC_MODELS=claude-sonnet-5-5,claude-opus-5-5,claude-haiku-5-5

# Code sandbox (neska/code/): lets Neska run Python to make PowerPoint, Excel and Word files.
# LibreChat signs a short-lived token per user; the sandbox checks it with the public half
# (CODEAPI_JWT_PUBLIC_KEY in code.env). base64 -w0 codeapi-jwt.pem
LIBRECHAT_CODE_BASEURL=http://codeapi:3112/v1
CODEAPI_AUTH_PROVIDER=librechat-jwt
CODEAPI_JWT_PRIVATE_KEY_BASE64=
CODEAPI_JWT_ALGORITHM=EdDSA
CODEAPI_JWT_KID=neska-codeapi-1
CODEAPI_JWT_ISSUER=librechat
CODEAPI_JWT_AUDIENCE=codeapi
CODEAPI_JWT_SINGLE_TENANT_ID=legacy
