# Copy to /etc/aibrain/<installation>/replica.env with mode 0600.
# The repository is fingerprinted in receipts but never persisted in cleartext.
AIBRAIN_RESTIC_REPOSITORY=s3:https://s3.example.invalid/aibrain-example-company
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
AWS_REGION=eu-central-1

# Alternative for HTTPS S3 endpoints with a path prefix (for example Supabase).
# Replace the AIBRAIN_RESTIC_REPOSITORY line above; do not duplicate env keys.
# AIBRAIN_RESTIC_REPOSITORY=rclone:backup:installation-backups/restic
# RCLONE_CONFIG_BACKUP_TYPE=s3
# RCLONE_CONFIG_BACKUP_PROVIDER=Other
# RCLONE_CONFIG_BACKUP_ENDPOINT=https://project-ref.storage.supabase.co/storage/v1/s3
# RCLONE_CONFIG_BACKUP_REGION=eu-west-1
# RCLONE_CONFIG_BACKUP_ACCESS_KEY_ID=replace_me
# RCLONE_CONFIG_BACKUP_SECRET_ACCESS_KEY=replace_me
# RCLONE_CONFIG_BACKUP_FORCE_PATH_STYLE=true
# RCLONE_CONFIG_BACKUP_NO_CHECK_BUCKET=true
